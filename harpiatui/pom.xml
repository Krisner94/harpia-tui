<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.krisner94</groupId>
        <artifactId>harpiatui-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>harpiatui</artifactId>
    <packaging>jar</packaging>

    <name>HarpiaTUI</name>
    <description>
        Biblioteca de TUI inline declarativa. A arvore de menus e resolvida em
        tempo de compilacao pelo harpiatui-processor: em runtime nao ha varredura
        de classpath nem reflexao sobre as annotations.
    </description>

    <dependencies>
        <!--
          O processor vem junto de proposito (escopo compile) para que quem so
          declare esta dependencia ja tenha a geracao de codigo funcionando:
          o javac descobre processors no classpath.
        -->
        <dependency>
            <groupId>com.github.krisner94</groupId>
            <artifactId>harpiatui-processor</artifactId>
        </dependency>

        <!-- Toolkit DSL: API declarativa com componentes e foco -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
        </dependency>

        <!-- Backend de terminal (JLine 3) -->
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-jline3-backend</artifactId>
        </dependency>

        <!-- Leitura do arquivo de menus declarativo -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.github.krisner94.harpiatui</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
